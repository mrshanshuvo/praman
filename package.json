{
  "name": "praman",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --write .",
    "test": "turbo test",
    "test:e2e": "pnpm --filter api test:e2e",
    "contract:emit": "pnpm --filter api contract:emit",
    "db:update": "pnpm --filter api db:update",
    "seed": "pnpm --filter api seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "turbo": "^2.11.2"
  },
  "packageManager": "pnpm@12.4.2"
}
