# ==============================================================================
# Praman Monorepo Environment Configuration Template
# Copy this file to `.env` and populate with your credentials.
# ==============================================================================

# Server & App Environment
NODE_ENV="development"
PORT=5000
FRONTEND_URL="http://localhost:3000"

# Database (PostgreSQL with Prisma 8)
DATABASE_URL="postgresql://user:password@localhost:5432/praman?sslmode=require"

# AI Inference & Models (Groq / OpenAI / Custom Gateway)
OPENAI_BASE_URL="https://api.groq.com/openai/v1"
OPENAI_API_KEY="your-api-key-here"
AI_MODELS="groq/compound-mini,openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.8-27b"

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="praman-resumes"
